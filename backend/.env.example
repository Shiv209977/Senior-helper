SECRET_KEY=change-me-in-development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Use sqlite for quick local development. Use postgresql for final/deployment.
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# PostgreSQL settings are used only when DB_ENGINE=postgresql.
DB_NAME=senior_friendly_app
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
